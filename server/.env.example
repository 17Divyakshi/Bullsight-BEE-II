# BullSight MERN Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/bullsight_db

# JWT Secret for Authentication
JWT_SECRET=bullsight_super_secure_jwt_secret_key_2026

# Optional External API Keys (Graceful fallbacks are built-in)
