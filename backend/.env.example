# BullSight AI Backend Environment Variables
PORT=8000
ENVIRONMENT=development

# Optional External API Keys
# Add your News API key from https://newsapi.org (optional)
NEWS_API_KEY=

# Add your OpenAI API key for conversational AI LLM capabilities (optional fallback included)
OPENAI_API_KEY=

# Database Configuration (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./bullsight.db
